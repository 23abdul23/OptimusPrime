# Neo4j Connection Details
# Preferred: point directly at the compose-managed OptimusKG Neo4j instance
NEO4J_URI=bolt://optimus-neo4j:7687
NEO4J_DATABASE=optimusKG
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=optimus-password

# Fallback host/port settings if NEO4J_URI is not provided
NEO4J_SCHEME=bolt
NEO4J_PORT=7687
NEO4J_HOST=neo4j
## Other Neo4j Configurations
NEO4J_MAX_POOL_SIZE=50

# Redis Connection Details
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
## Other Redis Configurations
REDIS_KEY_EXPIRY=900
REDIS_USER_EXPIRY=7200

# Only if want to change default 3000 port number
# PORT=<port-number>

# OpenAI API Key
OPENAI_API_KEY=


# For production, set NODE_ENV=production
# Also, in production set FRONTEND_URL to the URL of the frontend (for CORS)
# FRONTEND_URL=http://localhost:3000
NODE_ENV=development

