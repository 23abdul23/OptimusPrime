# This is an example of a .env file for the project. Copy this file to .env and fill in the values.
# Neo4j credentials for the compose-managed Neo4j container.
OPTIMUS_NEO4J_USERNAME=neo4j
OPTIMUS_NEO4J_PASSWORD=optimus-password
OPTIMUS_NEO4J_DATABASE=optimusKG

# Optional: override the backend's Neo4j target.
# Leave unset when the backend should use the compose-managed Neo4j service.
# OPTIMUS_BACKEND_NEO4J_URI=bolt://neo4j:7687

# Redis database credentials
REDIS_PASSWORD=test1234

# Host ports exposed by Docker on the server. Change these to avoid clashes.
OPTIMUS_FRONTEND_PORT=3500
OPTIMUS_BACKEND_PORT=4500
OPTIMUS_NEO4J_HTTP_PORT=7974
OPTIMUS_NEO4J_BOLT_PORT=8187
