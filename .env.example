# This is an example of a .env file for the project. Copy this file to .env and fill in the values.
# Live OptimusKG Neo4j connection used by docker compose
OPTIMUS_NEO4J_URI=bolt://host.docker.internal:17687
OPTIMUS_NEO4J_USERNAME=neo4j
OPTIMUS_NEO4J_PASSWORD=optimus-password
OPTIMUS_NEO4J_DATABASE=neo4j

# Redis database credentials
REDIS_PASSWORD=

# Clickhouse database credentials
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
